# Environment Variables Template — ATMODESK Bangladesh
# Copy this file to .env.local and fill in your actual production credentials

# Neon PostgreSQL Database URLs
DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Session Secret (generate using `openssl rand -base64 32`)
NEXTAUTH_URL="https://atmodeskbd-eo1e.vercel.app"
NEXTAUTH_SECRET="your-32-character-random-secret"
ADMIN_SESSION_SECRET="your-32-character-random-admin-secret"

# Admin Portal Credentials
ADMIN_EMAIL="admin@atmodeskbd.com"
ADMIN_PASSWORD="YourStrongAdminPassword2026!"

# Image Upload (ImgBB API Key)
IMGBB_API_KEY=""

# Public Store URL
NEXT_PUBLIC_BASE_URL="https://atmodeskbd-eo1e.vercel.app"

# Optional Payment Gateway Scaffolding
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_BASE_URL="https://sandbox.mynagad.com:10080/remote-payment-gateway-1.0"

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASS=""
SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"
